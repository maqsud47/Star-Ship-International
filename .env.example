# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Web3Forms — free contact-to-email service (no backend required).
# Create a free access key at https://web3forms.com using starshipdhaka@gmail.com
# and paste it below. The forms send submissions to that inbox.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Public site URL used for canonical URLs, sitemap and Open Graph.
# Leave the Vercel preview URL for staging; switch to the live domain once bought.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
