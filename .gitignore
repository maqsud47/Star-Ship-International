# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values, but keep the template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Raw source assets — kept on disk, not part of the deployable site.
# Processed/optimised copies used by the app live in public/photos and public/brand.
# Keep these folders backed up separately (they are not in git history).
/Photos/
/Logo/
/Company brochure/
